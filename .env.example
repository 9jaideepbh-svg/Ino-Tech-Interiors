# ── Cloudinary Upload Mode ────────────────────────────────────────────────────
# "unsigned"  → uses the unsigned upload preset (for development)
# "signed"    → uses server-side signature (recommended for production)
VITE_CLOUDINARY_UPLOAD_MODE=unsigned

# When VITE_CLOUDINARY_UPLOAD_MODE=signed, set this to your signing endpoint:
# VITE_CLOUDINARY_SIGN_ENDPOINT=/api/cloudinary/sign
